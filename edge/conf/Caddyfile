{
	email {$ACME_EMAIL}
}

# Une suppression (`-Server`) rend différé tout le bloc `header` qui la porte,
# et une erreur (401 de basic_auth, 502) court-circuite les en-têtes différés :
# la suppression reste donc dans sa propre directive.
(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
	header -Server
}

# Pré-ouverture : protège par mot de passe et rend non indexable un site qui
# n'est pas encore ouvert au public. L'importer dans le bloc d'un site pour le
# fermer, l'en retirer pour l'ouvrir.
(preview) {
	header X-Robots-Tag "noindex, nofollow"
	basic_auth {
		{$PREVIEW_USER} {$PREVIEW_HASH}
	}
}

www.{$CV_DOMAIN} {
	import hardening
	redir https://{$CV_DOMAIN}{uri} permanent
}

{$CV_DOMAIN} {
	import hardening
	encode zstd gzip
	reverse_proxy cv:8080
}
