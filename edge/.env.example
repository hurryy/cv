# Gabarit du `.env` attendu par edge/docker-compose.yml, à copier à côté sur le
# VPS. Aucune valeur réelle ici.

# requis — adresse de contact Let's Encrypt.
ACME_EMAIL=

# requis — domaine du CV, sans `www` (redirigé automatiquement). Il doit déjà
# pointer (A/AAAA) sur l'IP du VPS au premier démarrage, sinon Let's Encrypt
# échoue et retente avec un délai croissant.
CV_DOMAIN=

# requis — accès de pré-ouverture. PREVIEW_HASH est un hash bcrypt, jamais le
# mot de passe en clair :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<mot de passe>'
# Dans ce fichier, doubler chaque `$` du hash (`$$`), sinon Compose l'interprète.
PREVIEW_USER=
PREVIEW_HASH=
